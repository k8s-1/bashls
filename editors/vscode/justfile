default:
    @just --list

# install dependencies
install:
    bun install --frozen-lockfile

# type-check and bundle
build: install
    bun run compile

# package into bashls.vsix
package: build
    bunx --bun vsce package --no-dependencies -o bashls.vsix

# open a throwaway VS Code window with the built extension for a manual check
try file="../../scripts/get-options.sh": package
    code --wait --extensionDevelopmentPath="$PWD" "{{file}}"

# release: manual check, then bump version (patch/minor/major/x.y.z, default patch), commit, tag, and push
release increment="patch": try
    #!/usr/bin/env bash
    set -euo pipefail
    read -r -p "Did the extension work (hover/completion)? Bump, tag and push? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || { echo "aborted"; exit 1; }
    bun pm version --no-git-tag-version {{increment}}
    version=$(bun pm pkg get version | tr -d '"')
    git add package.json bun.lock
    git commit -m "chore(vscode): bump version to ${version}"
    git tag "bashls-vscode@${version}" -m "release"
    git push origin main --tags
